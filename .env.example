# Supabase — data layer for /api/auctions/*. NOT used for auth (Clerk owns auth).
NEXT_PUBLIC_SUPABASE_URL=https://mocerqjnksmhcjzxrewo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Preferred over the anon key server-side; falls back to anon key if unset.
SUPABASE_SERVICE_ROLE_KEY=

# Clerk auth — leave unset in dev to run passthrough middleware (see middleware.ts)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Mapbox GL — /auctions map view (AuctionMap, AuctionDetailMap). Without this
# the map renders a "Mapbox token not configured" placeholder instead of pins.
NEXT_PUBLIC_MAPBOX_TOKEN=

# MapillaryJS — street-level viewer on the Projects → Due Diligence tab
# (MapillaryViewer.tsx). A public client token by design (Mapillary expects it
# in the browser), same trust model as NEXT_PUBLIC_MAPBOX_TOKEN above. Without
# this the viewer renders a "Mapillary token not configured" placeholder.
# Register an app at mapillary.com/dashboard/developers to get a token.
NEXT_PUBLIC_MAPILLARY_CLIENT_TOKEN=

# Chatwoot Cloud website widget — bottom-right chat bubble, additive to the
# existing /chat (Deed) panel. Leave unset to render nothing (see
# ChatwootWidget.tsx). Mirrors CHATWOOT_WEBSITE_TOKEN_BIDDEED on the
# Cloudflare Worker side (src/worker.js in cli-anything-biddeed), which covers
# the routes this Next.js app does not.
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN_BIDDEED=
NEXT_PUBLIC_CHATWOOT_BASE_URL=

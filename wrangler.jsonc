{
  "name": "biddeed-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "kv_namespaces": [
    // PLACEHOLDER — no CLOUDFLARE_API_TOKEN/CLOUDFLARE_ACCOUNT_ID available in
    // this session, so `wrangler kv namespace create NEXT_CACHE_WORKERS_KV`
    // could not be run. Local-mode `wrangler dev` tolerates a placeholder id
    // (it never calls the Cloudflare API), but this MUST be replaced with a
    // real namespace id before any `wrangler deploy`. See docs/spec/19678.md.
    { "binding": "NEXT_CACHE_WORKERS_KV", "id": "REPLACE_WITH_REAL_KV_NAMESPACE_ID" }
  ]
}

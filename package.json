{
  "name": "biddeed-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "cf:build": "opennextjs-cloudflare build --config wrangler.staging.jsonc --env staging",
    "cf:preview": "opennextjs-cloudflare build --config wrangler.staging.jsonc --env staging && opennextjs-cloudflare preview --config wrangler.staging.jsonc --env staging",
    "cf:deploy:staging": "opennextjs-cloudflare build --config wrangler.staging.jsonc --env staging && wrangler deploy --config wrangler.staging.jsonc --env staging",
    "cf:build:production": "opennextjs-cloudflare build --config wrangler.production.jsonc --env production",
    "cf:deploy:production": "opennextjs-cloudflare build --config wrangler.production.jsonc --env production && wrangler deploy --config wrangler.production.jsonc --env production",
    "cf:typegen": "wrangler types --config wrangler.staging.jsonc --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:e2e:rls": "playwright test tests/e2e/rls-isolation.spec.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.15",
    "@clerk/nextjs": "^7.0.4",
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/list": "6.1.21",
    "@fullcalendar/react": "6.1.21",
    "@opennextjs/cloudflare": "1.20.6",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@supabase/supabase-js": "2.95.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.32.0",
    "mapbox-gl": "^3.0.0",
    "next": "16.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/mapbox-gl": "^3.0.0",
    "@types/node": "^22.7.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "wrangler": "4.128.0"
  }
}
